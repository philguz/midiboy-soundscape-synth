{
    "env": {
        "avrCore": "${env:LOCALAPPDATA}/Arduino15/packages/arduino/hardware/avr/1.8.6",
        "avrGcc": "${env:LOCALAPPDATA}/Arduino15/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino7",
        "blokas": "${env:LOCALAPPDATA}/Arduino15/packages/Blokas/hardware/avr/1.0.6"
    },
    "configurations": [
        {
            "name": "Midiboy",
            "compilerPath": "${avrGcc}/bin/avr-g++.exe",
            "compilerArgs": [
                "-mmcu=atmega328p",
                "-std=gnu++11",
                "-fno-exceptions",
                "-fno-threadsafe-statics"
            ],
            "intelliSenseMode": "gcc-x86",
            "cStandard": "gnu11",
            "cppStandard": "gnu++11",
            "includePath": [
                "${workspaceFolder}/MidiboySoundscape",
                "${avrCore}/cores/arduino",
                "${blokas}/variants/Midiboy",
                "${blokas}/libraries/Midiboy/src",
                "${avrGcc}/avr/include",
                "${avrGcc}/lib/gcc/avr/7.3.0/include",
                "${avrGcc}/lib/gcc/avr/7.3.0/include-fixed"
            ],
            "forcedInclude": [
                "${avrCore}/cores/arduino/Arduino.h"
            ],
            "defines": [
                "__AVR_ATmega328P__",
                "__AVR__",
                "F_CPU=20000000L",
                "ARDUINO=10607",
                "ARDUINO_AVR_MIDIBOY",
                "ARDUINO_ARCH_AVR",
                "MIDIBOY=6",
                "__uint24=unsigned long",
                "__int24=long"
            ]
        }
    ],
    "version": 4
}
